  "triggers": [
    {
      "tgname": "snapshot_borrowers",
      "tgenabled": "O",
      "definition": "CREATE TRIGGER snapshot_borrowers BEFORE INSERT ON machsan.reservations FOR EACH ROW EXECUTE FUNCTION machsan.reservation_snapshot()"
    }
  ],
  "functions": [
    {
      "proname": "reservation_snapshot",
      "prosrc": " BEGIN\n SELECT string_agg(u.name,' ו' ORDER BY u.id),string_agg(DISTINCT t.name,', '),string_agg(u.phone,','),array_agg(u.id) INTO NEW.names,NEW.team_name,NEW.borrower_phones,NEW.borrower_ids FROM instructor_unit_members m JOIN users u ON u.id=m.user_id LEFT JOIN scout_teams t ON t.id=u.team_id WHERE m.unit_id=NEW.unit_id;\n RETURN NEW; END ",
      "proconfig": [
        "search_path=machsan, public"
      ],
      "prosecdef": false
    }
  ]
}
