DATABASE_URL=postgresql://machsan_app:PASSWORD@HOST:5432/postgres
# Local development only when the Supabase CA certificate is not installed.
# Keep this unset/false in production.
DATABASE_SSL_ALLOW_INSECURE_LOCAL=false
# PEM text or an absolute path to Supabase's downloaded root CA file.
DATABASE_SSL_ROOT_CERT=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=REPLACE_WITH_OPENSSL_RAND_BASE64_32
ADMIN_PHONE=
ADMIN_NAME=
ADMIN_PASSWORD=
